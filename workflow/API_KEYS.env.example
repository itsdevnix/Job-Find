# Job-Find — all API keys / secrets this project needs, in one place.
#
# This file is a REFERENCE TEMPLATE, not something anything reads automatically.
# Copy each value to where it actually belongs (see the section headers below),
# then keep this file out of git (already covered by .gitignore patterns for *.env*).
#
# Two different destinations exist because two different systems consume these:
#   1. The n8n instance itself (self-hosted .env, or your host's env var settings)
#   2. This repo's Next.js frontend (job-search/frontend/.env.local)

# ============================================================================
# 1. n8n instance environment variables
#    Set these on the n8n instance (self-hosted .env, or the host's dashboard).
#    Workflow nodes read them via {{ $env.VAR_NAME }} — raw values never appear
#    in the workflow JSON. If $env access is blocked on your host, see the
#    fallback note in SETUP.md section 1.
# ============================================================================

# Adzuna app ID + key (developer.adzuna.com) — powers "Fetch Adzuna Jobs"
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Jooble API key (jooble.org/api/about) — powers "Fetch Jooble Jobs"
JOOBLE_API_KEY=your_jooble_api_key

# Apify API token (console.apify.com) — powers "Apify" (Indeed scraper)
# and "Fetch LinkedIn Jobs (Apify)". Same token, two different actors.
APIFY_API_TOKEN=your_apify_api_token

# Google Sheets spreadsheet ID (from the results sheet's URL) — used by
# Read Applied History, Google Sheets, Log Run Started/Complete,
# Read Run Status, Read Run Results
GOOGLE_SHEETS_ID=your_google_sheets_id

# ----------------------------------------------------------------------------
# Native n8n credentials — NOT env vars, can only be created via the n8n UI.
# Listed here so every key this project needs is in one file, but there is
# nothing to paste into n8n's env settings for these:
#   - Google Sheets: OAuth2 credential, attach to the 6 Sheets nodes above
#   - OpenAI: API key credential, attach to "OpenAI Chat Model (Evaluator)"
#   - SerpApi: Query Auth credential (name "SerpApi Query Auth", param name
#     "api_key"), attach to "Fetch Google Jobs". SerpApi only accepts the key
#     as a query param — no Authorization header support — so a $env
#     expression would still leave it visible in query strings on export;
#     Query Auth keeps it out of the workflow JSON entirely. See SETUP.md.
#   - Gmail: OAuth2 credential (no static key — interactive Google consent
#     flow in the n8n UI), attach to "Create Gmail Draft". Drafts application
#     emails only; the workflow never sends them. See SETUP.md.
SERPAPI_KEY_FOR_QUERY_AUTH_CREDENTIAL=your_serpapi_key
# ----------------------------------------------------------------------------

# ============================================================================
# 2. Frontend — job-search/frontend/.env.local
#    Server-only (no NEXT_PUBLIC_ prefix) so these never reach the browser.
# ============================================================================

N8N_JOB_SEARCH_WEBHOOK_URL=
N8N_JOB_RESULTS_WEBHOOK_URL=
